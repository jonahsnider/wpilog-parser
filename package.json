{
	"name": "wpilog-parser-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"api:check": "vp run build && vp run -r api:check",
		"api:update": "vp run build && vp run -r api:update",
		"bench": "vp run build && vp test bench",
		"build": "vp run -r build",
		"check": "vp run build && vp check",
		"dev": "vp run --filter wpilog-parser dev",
		"prepare": "vp config",
		"pack:check": "vp run api:check && node scripts/check-packages.ts",
		"start": "vp run --filter wpilog-parser start",
		"test": "vp run build && vp test run"
	},
	"devDependencies": {
		"@codspeed/vitest-plugin": "6.1.0",
		"@types/node": "26.6.6",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"typescript": "7.0.2",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x"
		}
	},
	"packageManager": "pnpm@12.16.1"
}
