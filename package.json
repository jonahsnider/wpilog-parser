{
	"name": "wpilog-parser",
	"version": "2.3.0",
	"description": "Read WPILib wpilog data log files in TypeScript & JavaScript",
	"homepage": "https://github.com/jonahsnider/wpilog-parser#readme",
	"license": "MIT",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/wpilog-parser.git"
	},
	"bin": {
		"wpilog": "./dist/cli.mjs"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"bench": "vp test bench",
		"build": "vp pack",
		"check": "vp check",
		"dev": "vp pack --watch",
		"generate": "node ./src/struct/codegen.ts",
		"prepare": "vp config",
		"prepublishOnly": "vp run build",
		"start": "node ./src/cli.ts",
		"test": "vp test"
	},
	"dependencies": {
		"@toon-format/toon": "^4.1.1",
		"cac": "^7.0.0",
		"chevrotain": "^13.0.0"
	},
	"devDependencies": {
		"@codspeed/vitest-plugin": "5.7.1",
		"@types/node": "26.2.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"typescript": "7.0.2",
		"vite-plus": "0.3.0"
	},
	"packageManager": "pnpm@12.0.0-rc.8"
}
