{
	"name": "wpilog-parser",
	"version": "3.1.2",
	"description": "Read WPILib wpilog data log files in TypeScript & JavaScript",
	"homepage": "https://github.com/jonahsnider/wpilog-parser#readme",
	"license": "MIT",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/wpilog-parser.git"
	},
	"bin": {
		"wpilog": "dist/cli.mjs"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"api:check": "api-extractor run",
		"api:update": "api-extractor run --local",
		"bench": "vp test bench",
		"build": "vp pack",
		"check": "vp check",
		"dev": "vp pack --watch",
		"preapi:check": "vp run build",
		"preapi:update": "vp run build",
		"prepare": "vp config",
		"prepublishOnly": "vp run api:check",
		"start": "node ./src/cli.ts",
		"test": "vp test"
	},
	"dependencies": {
		"@bomb.sh/tab": "^0.0.22",
		"@drizzle-team/brocli": "^0.12.1",
		"@toon-format/toon": "^4.1.1",
		"nostics": "^1.3.0",
		"osc-status": "^1.0.0"
	},
	"devDependencies": {
		"@codspeed/vitest-plugin": "6.1.0",
		"@microsoft/api-extractor": "7.60.0",
		"@types/node": "26.6.5",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"typescript": "7.0.2",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x"
		}
	},
	"packageManager": "pnpm@12.16.1",
	"tsdocMetadata": "./dist/tsdoc-metadata.json"
}
