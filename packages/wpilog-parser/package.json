{
	"name": "wpilog-parser",
	"version": "3.2.1",
	"description": "Read WPILib wpilog data log files in TypeScript & JavaScript",
	"homepage": "https://github.com/jonahsnider/wpilog-parser#readme",
	"license": "MIT",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/wpilog-parser.git",
		"directory": "packages/wpilog-parser"
	},
	"bin": {
		"wpilog": "./dist/cli.mjs"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"api:check": "api-extractor run",
		"api:update": "api-extractor run --local",
		"bench": "vp test bench",
		"build": "vp pack",
		"check": "vp check",
		"dev": "vp pack --watch",
		"prepublishOnly": "pnpm build && pnpm api:check",
		"start": "node ./src/cli.ts",
		"test": "vp test"
	},
	"dependencies": {
		"@bomb.sh/tab": "^0.0.22",
		"@drizzle-team/brocli": "^0.12.1",
		"@toon-format/toon": "^4.1.1",
		"nostics": "^1.3.0",
		"osc-status": "^1.0.0",
		"wpilib-struct": "workspace:^"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "7.60.1",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"tsdocMetadata": "./dist/tsdoc-metadata.json"
}
